# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://spotify:spotify@localhost:5432/spotify_clone?schema=public"

# Generate any random long string for local dev
JWT_SECRET="change_me_dev_secret"

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

PORT=4000
